<!-- Quick Component Gallery — Two-column layout: Base (Fluent) | Material You -->
<App title="Quick Component Gallery" width="1200" height="900">
  <VStack style="width: 100%; min-height: 100%; padding: 0px; gap: 0px; background: #FAFAFA;">

    <!-- Header bar -->
    <HStack style="width: 100%; padding: 16px 24px; background: #FFFFFF; border-bottom: 1px #E0E0E0; gap: 16px; align-items: center;">
      <Text text="⚡ Quick Component Gallery" style="font-size: 18px; color: #212121;" />
      <Text text="v0.2 — Standard 12px Typography & Full-Window Layout" style="font-size: 12px; color: #757575;" />
    </HStack>

    <!-- Column headers -->
    <HStack style="width: 100%; padding: 8px 24px; background: #F5F5F5; border-bottom: 1px #E0E0E0;">
      <Container style="width: 50%; padding: 4px 8px;">
        <Text text="Base Theme (Avalonia Fluent, OS Adaptive)" style="font-size: 12px; color: #424242;" />
      </Container>
      <Container style="width: 50%; padding: 4px 8px;">
        <Text text="Material You (Dynamic Color, M3)" style="font-size: 12px; color: #424242;" />
      </Container>
    </HStack>

    <!-- SECTION: Buttons -->
    <HStack style="width: 100%; padding: 20px 24px; gap: 24px; border-bottom: 1px #EEEEEE;">
      <VStack style="width: 50%; gap: 12px;">
        <Text text="BUTTONS" style="font-size: 10px; color: #9E9E9E;" />
        <HStack style="gap: 8px;">
          <Button text="Primary" variant="filled" />
          <Button text="Secondary" variant="tonal" />
          <Button text="Elevated" variant="elevated" />
        </HStack>
        <HStack style="gap: 8px;">
          <Button text="Outlined" variant="outlined" />
          <Button text="Text" variant="text" />
        </HStack>
      </VStack>
      <VStack style="width: 50%; gap: 12px;" theme="material-you">
        <Text text="BUTTONS" style="font-size: 10px; color: #9E9E9E;" />
        <HStack style="gap: 8px;">
          <Button text="Primary" variant="filled" />
          <Button text="Tonal" variant="tonal" />
          <Button text="Elevated" variant="elevated" />
        </HStack>
        <HStack style="gap: 8px;">
          <Button text="Outlined" variant="outlined" />
          <Button text="Text" variant="text" />
        </HStack>
      </VStack>
    </HStack>

    <!-- SECTION: Cards -->
    <HStack style="width: 100%; padding: 20px 24px; gap: 24px; border-bottom: 1px #EEEEEE;">
      <VStack style="width: 50%; gap: 12px;">
        <Text text="CARDS" style="font-size: 10px; color: #9E9E9E;" />
        <HStack style="gap: 12px;">
          <Card variant="elevated">
            <Text text="Elevated Card" style="font-size: 12px;" />
            <Text text="Subtle border, flat default" style="font-size: 10px; color: #757575;" />
          </Card>
          <Card variant="filled">
            <Text text="Filled Card" style="font-size: 12px;" />
          </Card>
          <Card variant="outlined">
            <Text text="Outlined Card" style="font-size: 12px;" />
          </Card>
        </HStack>
      </VStack>
      <VStack style="width: 50%; gap: 12px;" theme="material-you">
        <Text text="CARDS" style="font-size: 10px; color: #9E9E9E;" />
        <HStack style="gap: 12px;">
          <Card variant="elevated">
            <Text text="Elevated Card" style="font-size: 12px;" />
            <Text text="M3 surface tint" style="font-size: 10px;" />
          </Card>
          <Card variant="filled">
            <Text text="Filled Card" style="font-size: 12px;" />
          </Card>
          <Card variant="outlined">
            <Text text="Outlined Card" style="font-size: 12px;" />
          </Card>
        </HStack>
      </VStack>
    </HStack>

    <!-- SECTION: Selection Controls -->
    <HStack style="width: 100%; padding: 20px 24px; gap: 24px; border-bottom: 1px #EEEEEE;">
      <VStack style="width: 50%; gap: 12px;">
        <Text text="SELECTION" style="font-size: 10px; color: #9E9E9E;" />
        <HStack style="gap: 24px; align-items: center;">
          <Switch checked="$sw_base" onchange="on_switch_base" />
          <Checkbox checked="$cb_base" onchange="on_check_base" />
          <Chip text="WiFi" selected="$chip1" onclick="on_chip1" />
          <Chip text="Bluetooth" selected="$chip2" onclick="on_chip2" />
        </HStack>
      </VStack>
      <VStack style="width: 50%; gap: 12px;" theme="material-you">
        <Text text="SELECTION" style="font-size: 10px; color: #9E9E9E;" />
        <HStack style="gap: 24px; align-items: center;">
          <Switch checked="$sw_m3" onchange="on_switch_m3" />
          <Checkbox checked="$cb_m3" onchange="on_check_m3" />
          <Chip text="WiFi" selected="$chip3" onclick="on_chip3" />
          <Chip text="Bluetooth" selected="$chip4" onclick="on_chip4" />
        </HStack>
      </VStack>
    </HStack>

    <!-- SECTION: Inputs -->
    <HStack style="width: 100%; padding: 20px 24px; gap: 24px; border-bottom: 1px #EEEEEE;">
      <VStack style="width: 50%; gap: 12px;">
        <Text text="INPUTS" style="font-size: 10px; color: #9E9E9E;" />
        <TextInput placeholder="Type something…" value="$input_base" />
        <Slider min="0" max="100" value="$slider_base" />
      </VStack>
      <VStack style="width: 50%; gap: 12px;" theme="material-you">
        <Text text="INPUTS" style="font-size: 10px; color: #9E9E9E;" />
        <TextInput placeholder="Type something…" value="$input_m3" />
        <Slider min="0" max="100" value="$slider_m3" />
      </VStack>
    </HStack>

    <!-- SECTION: Progress -->
    <HStack style="width: 100%; padding: 20px 24px; gap: 24px; border-bottom: 1px #EEEEEE;">
      <VStack style="width: 50%; gap: 12px;">
        <Text text="PROGRESS" style="font-size: 10px; color: #9E9E9E;" />
        <ProgressBar progress="$progress_base" min="0" max="1" />
        <Text text="65% loaded" style="font-size: 10px; color: #757575;" />
      </VStack>
      <VStack style="width: 50%; gap: 12px;" theme="material-you">
        <Text text="PROGRESS" style="font-size: 10px; color: #9E9E9E;" />
        <ProgressBar progress="$progress_m3" min="0" max="1" />
        <Text text="65% loaded" style="font-size: 10px; color: #757575;" />
      </VStack>
    </HStack>

    <!-- SECTION: Typography -->
    <HStack style="width: 100%; padding: 20px 24px; gap: 24px; border-bottom: 1px #EEEEEE;">
      <VStack style="width: 50%; gap: 8px;">
        <Text text="TYPOGRAPHY" style="font-size: 10px; color: #9E9E9E;" />
        <Text text="Caption — 10px" style="font-size: 10px; color: #757575;" />
        <Text text="Body (Standard) — 12px" style="font-size: 12px; color: #212121;" />
        <Text text="Body Large — 14px" style="font-size: 14px; color: #212121;" />
        <Text text="Title — 16px" style="font-size: 16px; color: #212121;" />
        <Text text="Display — 22px" style="font-size: 22px; color: #212121;" />
      </VStack>
      <VStack style="width: 50%; gap: 8px;" theme="material-you">
        <Text text="TYPOGRAPHY" style="font-size: 10px; color: #9E9E9E;" />
        <Text text="Caption — 10px" style="font-size: 10px;" />
        <Text text="Body (Standard) — 12px" style="font-size: 12px;" />
        <Text text="Body Large — 14px" style="font-size: 14px;" />
        <Text text="Title — 16px" style="font-size: 16px;" />
        <Text text="Display — 22px" style="font-size: 22px;" />
      </VStack>
    </HStack>

    <!-- SECTION: Noctalia Desktop Shell & Wayland UI Suite -->
    <VStack style="width: 100%; padding: 20px 24px; gap: 16px; background: #070722;" theme="noctalia">
      <Text text="🌙 NOCTALIA DESKTOP SHELL & UMBRIEL WAYLAND SUITE" style="font-size: 12px; color: #fff59b; font-weight: bold;" />
      
      <!-- Frameless Window TitleBar -->
      <FramelessTitleBar title="Noctalia Desktop Shell" subtitle="v0.3 — Umbriel Wayland Compositor" />

      <!-- Wayland Desktop Status Bar -->
      <NoctaliaBar />

      <!-- Glassmorphic Buttons Strip -->
      <HStack style="gap: 12px; align-items: center;">
        <NoctaliaButton text="Primary Gold" variant="primary" />
        <NoctaliaButton text="Secondary" variant="secondary" />
        <NoctaliaButton text="Ghost" variant="ghost" />
        <NoctaliaButton text="Outline" variant="outline" />
        <NoctaliaButton text="Danger" variant="danger" />
      </HStack>

      <!-- Glassmorphic Card containing Interactive Controls -->
      <NoctaliaCard style="padding: 16px; gap: 16px;">
        <HStack style="width: 100%; gap: 24px; align-items: center;">
          <CountdownRing progress="0.75" size="130" text="75%" />
          <AnalogClock hours="10" minutes="10" seconds="35" timezone="Noctalia Time (UTC+0)" />
          <VStack style="gap: 12px;">
            <Segmented items="Standard,Scientific,Programmer" selected="0" />
            <NoctaliaSlider min="0" max="100" value="80" icon="🔊" />
          </VStack>
        </HStack>
      </NoctaliaCard>

      <!-- Metrics Graph, Calendar & Color Picker Strip -->
      <HStack style="gap: 20px;">
        <NoctaliaGraph label="CPU Load" />
        <NoctaliaCalendar />
        <NoctaliaColorPicker />
      </HStack>
    </VStack>

  </VStack>
</App>
