<!-- Quick Native Application: Responsive Hello World Starter Project -->
<VStack id="app-root" class="surface" style="width: 100%; height: 100%; padding: 24px; align-items: center; justify-content: center; background: #0d1117;">
    
    <Style>
        Container.card {
            background: #161b22;
            border-radius: 16px;
            border-color: #30363d;
            border-width: 1px;
            padding: 32px;
            align-items: center;
            justify-content: center;
            gap: 16px;
            width: 90%;
            max-width: 560px;
        }
        Text.pill {
            font-size: 11px;
            font-weight: bold;
            color: #58a6ff;
            background: #1f2937;
            padding: 6px 14px;
            border-radius: 99px;
            text-align: center;
        }
        Text.title {
            font-size: 26px;
            font-weight: bold;
            color: #f0f6fc;
            text-align: center;
        }
        Text.greeting {
            font-size: 15px;
            color: #7ee787;
            font-weight: bold;
            text-align: center;
        }
        Text.description {
            font-size: 13px;
            color: #8b949e;
            text-align: center;
        }
        Button.btn-primary {
            background: #238636;
            color: #ffffff;
            padding: 10px 24px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: bold;
        }
        Button.btn-primary:hover {
            background: #2ea043;
        }
        Button.btn-secondary {
            background: #21262d;
            color: #c9d1d9;
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 14px;
        }
        Button.btn-secondary:hover {
            background: #30363d;
        }
    </Style>

    <Container class="card">
        <Text class="pill" text="QUICK NATIVE RUNTIME • 100% PURE RUST" />
        <Text class="title" text="Hello, Quick World!" />
        <Text id="greeting-box" class="greeting" text="$greeting" />
        <Text class="description" text="$description" />

        <HStack style="gap: 16px; margin: 12px 0px 0px 0px; justify-content: center; align-items: center;">
            <Button id="btn-interact" class="btn-primary" text="Click Me" onclick="on_click" />
            <Button id="btn-reset" class="btn-secondary" text="Reset" onclick="on_reset" />
        </HStack>
    </Container>

</VStack>
