<!-- Quick Native Application: Material You Theme Package Showcase -->
<VStack id="app-root" theme="material-you" style="width: 100%; height: 100%; padding: 32px; align-items: center; justify-content: center; background: #141218;">
    
    <Style>
        Card.main-card {
            background: #211F26;
            border-radius: 20px;
            border-color: #49454F;
            border-width: 1px;
            padding: 32px;
            align-items: center;
            justify-content: center;
            gap: 16px;
            width: 90%;
            max-width: 580px;
        }
        Text.pill-badge {
            font-size: 11px;
            font-weight: bold;
            color: #D0BCFF;
            background: #381E72;
            padding: 6px 14px;
            border-radius: 99px;
            text-align: center;
        }
        Text.title {
            font-size: 26px;
            font-weight: bold;
            color: #E6E0E9;
            text-align: center;
        }
        Text.greeting {
            font-size: 15px;
            color: #D0BCFF;
            font-weight: bold;
            text-align: center;
        }
        Text.description {
            font-size: 13px;
            color: #CAC4D0;
            text-align: center;
        }
        Button.btn-primary {
            background: #D0BCFF;
            color: #381E72;
            padding: 10px 24px;
            border-radius: 99px;
            font-size: 14px;
            font-weight: bold;
        }
        Button.btn-primary:hover {
            background: #EADDFF;
        }
        Button.btn-secondary {
            background: #49454F;
            color: #E6E0E9;
            padding: 10px 20px;
            border-radius: 99px;
            font-size: 14px;
        }
        Button.btn-secondary:hover {
            background: #5E5A66;
        }
    </Style>

    <Card class="main-card">
        <Text class="pill-badge" text="MATERIAL YOU THEME PACKAGE ACTIVE" />
        <Text class="title" text="Hello, Quick World!" />
        <Text id="greeting-box" class="greeting" text="$greeting" />
        <Text class="description" text="$description" />

        <!-- Form Controls Section -->
        <HStack style="justify-content: space-between; align-items: center; width: 100%; padding: 8px 0px;">
            <Text style="font-size: 14px; color: #E6E0E9; font-weight: bold;" text="Dynamic GPU Acceleration" />
            <Switch checked="$gpu_enabled" onchange="toggle_gpu" />
        </HStack>

        <VStack style="width: 100%; gap: 6px;">
            <Text style="font-size: 12px; color: #CAC4D0; font-weight: bold;" text="Display Brightness / Scale" />
            <Slider min="0" max="100" value="$brightness" onchange="on_slider" />
        </VStack>

        <!-- Interactive Chip Filter Strip -->
        <HStack style="gap: 8px; justify-content: center; align-items: center; margin: 4px 0px;">
            <Chip text="Wayland EGL" selected="$chip_wayland" onclick="toggle_wayland" />
            <Chip text="Pure Rust" selected="$chip_rust" onclick="toggle_rust" />
            <Chip text="Vello GPU" selected="$chip_vello" onclick="toggle_skia" />
        </HStack>

        <!-- Action Buttons -->
        <HStack style="gap: 16px; margin-top: 12px; justify-content: center; align-items: center;">
            <Button id="btn-interact" class="btn-primary" text="Click Me" onclick="on_click" />
            <Button id="btn-reset" class="btn-secondary" text="Reset" onclick="on_reset" />
        </HStack>
    </Card>

</VStack>
