<!-- Quick Application Framework: Hello World (.quick format) -->
<VStack id="app-root" class="surface" style="padding: 40px; gap: 20px; align-items: center; justify-content: center; background: #0f111a; width: 640px; height: 480px;">
    
    <Style>
        Container.card {
            background: #1a1b26;
            border-radius: 16px;
            border-color: #2f3549;
            border-width: 1px;
            padding: 32px;
            align-items: center;
            justify-content: center;
            gap: 16px;
            width: 480px;
        }
        Text.badge {
            font-size: 11px;
            font-weight: bold;
            color: #7aa2f7;
            background: #24283b;
            padding: 4px 12px;
            border-radius: 99px;
        }
        Text.title {
            font-size: 28px;
            font-weight: bold;
            color: #c0caf5;
        }
        Text.message {
            font-size: 16px;
            color: #7dcfff;
            font-weight: bold;
        }
        Text.subtext {
            font-size: 13px;
            color: #9aa5ce;
            text-align: center;
        }
        Button.btn-greet {
            background: #7aa2f7;
            color: #0f111a;
            padding: 10px 28px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: bold;
        }
        Button.btn-greet:hover {
            background: #89b4fa;
        }
        Button.btn-reset {
            background: #24283b;
            color: #c0caf5;
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 14px;
        }
        Button.btn-reset:hover {
            background: #414868;
        }
    </Style>

    <Container class="card">
        <Text class="badge" text="⚡ QUICK NATIVE RUNTIME • 100% PURE RUST" />
        <Text class="title" text="Hello, Quick World!" />
        <Text id="greeting-display" class="message" text="$greeting" />
        <Text class="subtext" text="$subtext" />

        <HStack style="gap: 12px; margin: 16px 0px 0px 0px;">
            <Button id="btn-say-hello" class="btn-greet" text="✨ Click Me!" onclick="greet" />
            <Button id="btn-reset" class="btn-reset" text="🔄 Reset" onclick="reset" />
        </HStack>
    </Container>

</VStack>
