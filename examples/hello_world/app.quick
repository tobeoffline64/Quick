<!-- Quick Application Framework: Hello World (.quick format) -->
<VStack id="app-root" class="surface" style="width: 100%; height: 100%; padding: 32px; align-items: center; justify-content: center; background: #0f111a;">
    
    <Style>
        VStack.card {
            background: #1a1b26;
            border-radius: 16px;
            border-color: #2f3549;
            border-width: 1px;
            padding: 36px 40px;
            align-items: center;
            justify-content: center;
            gap: 20px;
            width: 90%;
            max-width: 580px;
        }
        Text.badge {
            font-size: 11px;
            font-weight: bold;
            color: #7aa2f7;
            background: #24283b;
            padding: 6px 14px;
            border-radius: 99px;
            text-align: center;
        }
        Text.title {
            font-size: 26px;
            font-weight: bold;
            color: #c0caf5;
            text-align: center;
        }
        Text.message {
            font-size: 15px;
            color: #7dcfff;
            font-weight: bold;
            text-align: center;
        }
        Text.subtext {
            font-size: 13px;
            color: #9aa5ce;
            text-align: center;
        }
        Button.btn-greet {
            background: #7aa2f7;
            color: #0f111a;
            padding: 10px 24px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: bold;
        }
        Button.btn-greet:hover {
            background: #89b4fa;
        }
        Button.btn-reset {
            background: #24283b;
            color: #c0caf5;
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 14px;
        }
        Button.btn-reset:hover {
            background: #414868;
        }
    </Style>

    <VStack class="card">
        <Text class="badge" text="QUICK NATIVE RUNTIME • 100% PURE RUST" />
        <Text class="title" text="Hello, Quick World!" />
        <Text id="greeting-display" class="message" text="$greeting" />
        <Text class="subtext" text="$subtext" />

        <HStack style="gap: 16px; margin: 12px 0px 0px 0px; justify-content: center; align-items: center;">
            <Button id="btn-say-hello" class="btn-greet" text="Click Me" onclick="greet" />
            <Button id="btn-reset" class="btn-reset" text="Reset" onclick="reset" />
        </HStack>
    </VStack>

</VStack>
